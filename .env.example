# --- Banco de dados (Postgres) ---
# Use DATABASE_URL (Supabase/Neon/Render) OU as variáveis DB_* separadas.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha
DB_NAME=escola_conecta
# true se o banco exige TLS (Supabase, Neon, Render). Local: false.
DB_SSL=false
# Sempre false: o esquema muda só por migrations (ver README).
DB_SYNC=false

# --- Autenticação ---
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=86400

# --- App ---
PORT=4001
# Pode ter vários domínios separados por vírgula.
FRONTEND_URL=http://localhost:3001

# --- E-mails (Brevo) ---
# Avisos de novo comunicado e de nova mensagem. Sem a chave, nada é enviado.
# Fora de produção o e-mail só vai para o log, a menos que MAIL_FORCE_SEND=true.
BREVO_API_KEY=
# Remetente: precisa estar verificado no Brevo (Senders, domains & IPs).
MAIL_FROM_ADDRESS=avisos@suaescola.com.br
MAIL_FROM_NAME=MuralFlow
MAIL_FORCE_SEND=false
